# =============================================================================
# Example environment configuration.
#
# Copy to `.env` and adjust for your environment:  cp .env.example .env
# NEVER commit the real `.env`. All values below are safe, non-secret defaults
# suitable for local development only.
# =============================================================================

# --- Application ---------------------------------------------------------
APP_ENV=development            # development | staging | production | testing
DEBUG=true
PROJECT_NAME="FastAPI Enterprise Backend"
VERSION=0.1.0

# --- API / Server --------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# OpenAPI docs endpoints (set to blank to disable in production).
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# --- Security ------------------------------------------------------------
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-this-is-not-a-secret
# Comma-separated Host header allow-list. Use explicit hosts in production.
ALLOWED_HOSTS=*
# Comma-separated list of allowed CORS origins (leave empty to disallow all).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Redis ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- Celery --------------------------------------------------------------
# Defaults to the Redis instance above when left blank.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false
# CELERY_EAGER_BACKGROUND=false  # eager only: run tasks on a thread, not inline

# --- Local storage ---------------------------------------------------------
# Root of the on-disk tree (uploads/ processed/ temp/ thumbnails/ logs/).
STORAGE_ROOT=storage

# --- File uploads ------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=20

# --- Retention & cleanup ------------------------------------------------------
FILE_RETENTION_HOURS=24
TEMP_FILE_MAX_AGE_MINUTES=120
CLEANUP_INTERVAL_MINUTES=15

# --- External PDF tooling ------------------------------------------------------
TOOL_COMMAND_TIMEOUT_SECONDS=240
# LibreOffice launcher (bare name on PATH, or quoted absolute path).
# Windows example: SOFFICE_BIN="C:\Program Files\LibreOffice\program\soffice.exe"
SOFFICE_BIN=soffice
# Office conversion engine (PPT/Word/Excel -> PDF):
#   auto      (default) run a managed unoserver pool when possible — warm
#             LibreOffice instances, no per-conversion startup (~5-10x faster
#             under load) — otherwise fall back to per-conversion soffice.
#   unoserver require the managed pool; fail loudly when it cannot start.
#   soffice   always one soffice process per conversion.
# To enable the fast engine, `pip install unoserver` into this backend's
# environment:
#   * Windows: that is ALL — the pool runs the package under LibreOffice's
#     bundled python.exe (found next to SOFFICE_BIN) automatically.
#   * Linux:  also `apt install python3-uno`, and either create the venv
#     with --system-site-packages or install unoserver system-wide so the
#     `unoserver` script can reach the uno bindings.
OFFICE_ENGINE=auto
# Long-lived LibreOffice instances per worker process (~200-400 MB RSS each);
# also caps how many Office files one job converts concurrently.
UNOSERVER_POOL_SIZE=2
# Explicit launcher for the pool's server process when auto-detection isn't
# enough (quoted path + args allowed).
# UNOSERVER_BIN="C:\Program Files\LibreOffice\program\python.exe" -m unoserver.server
# Optional: use an *externally managed* unoserver instead of the built-in
# pool (you start/supervise it yourself). Takes precedence over OFFICE_ENGINE.
# UNOCONVERT_BIN=unoconvert
# Poppler pdftoppm (PDF -> image rendering).
PDFTOPPM_BIN=pdftoppm
# Ghostscript (PDF compression). Windows: GHOSTSCRIPT_BIN=gswin64c
GHOSTSCRIPT_BIN=gs
# OCRmyPDF (searchable text layer for scans). When left as the bare name
# and not on PATH, the app runs `python -m ocrmypdf` in its own venv.
OCRMYPDF_BIN=ocrmypdf
# Tesseract OCR engine (OCRmyPDF dependency; also used directly for
# language auto-detection). Bare name falls back to well-known Windows
# install dirs. Paths with spaces need double quotes inside single quotes:
# TESSERACT_BIN='"C:/Program Files/Tesseract-OCR/tesseract.exe"'
TESSERACT_BIN=tesseract
# Directory holding Tesseract .traineddata language packs (exported as
# TESSDATA_PREFIX). Leave empty to use Tesseract's bundled tessdata dir.
# The app expects these packs to exist (see SUPPORTED_OCR_LANGUAGES):
# eng ara chi_sim chi_tra deu ell fra heb hin ita jpn kor nld pol por rus
# spa tha tur urd vie + osd, e.g. from tessdata_fast. If you point this at
# a custom dir, also copy Tesseract's configs/ + tessconfigs/ next to them.
TESSDATA_DIR=
# Note: the Repair PDF tool needs no external binary — it rebuilds damaged
# PDFs in-process via libqpdf, bundled inside the pikepdf dependency.

# --- Authentication ------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# PDFs beyond this page count render as parallel chunks with this many workers.
RENDER_PARALLEL_THRESHOLD_PAGES=16
RENDER_PARALLEL_WORKERS=4

# --- Rate limiting ------------------------------------------------------------
# Max uploads per client IP per minute (0 disables). Fails open without Redis.
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_RENDERER=console          # console (dev) | json (prod)
LOG_TO_FILE=true              # also write rotating JSON logs to <STORAGE_ROOT>/logs/

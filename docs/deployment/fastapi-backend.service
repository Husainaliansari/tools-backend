# systemd unit for the FastAPI backend (Gunicorn + Uvicorn workers).
#
# Install:
#   sudo cp docs/deployment/fastapi-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fastapi-backend
#
# Adjust paths/user to match your deployment layout.

[Unit]
Description=FastAPI Enterprise Backend (Gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=notify
User=www-data
Group=www-data

# Absolute path to the project's backend directory.
WorkingDirectory=/opt/fastapi-backend/backend

# Load environment (secrets, DB URL, etc.) from the deployed .env file.
EnvironmentFile=/opt/fastapi-backend/backend/.env
Environment=PATH=/opt/fastapi-backend/backend/.venv/bin

ExecStart=/opt/fastapi-backend/backend/.venv/bin/gunicorn app.main:app -c gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID

Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# --- Hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
